<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fastfetch is a command-line tool: it is launched from a shell, walks the
  process tree to find that shell and terminal, reads the IORegistry, and reads
  files all over the bootstrap. Three entitlements make that work on a
  jailbroken device:

  platform-application
      Marks the binary as a platform binary. An ad-hoc signed executable
      without it is denied the process inspection and file access below.

  com.apple.private.security.no-sandbox
      Everything fastfetch reports comes from outside any container.

  com.apple.private.security.container-required = false
      Keeps fastfetch out of a data container, so HOME resolves to the real
      home of whoever ran it (~/.config/fastfetch) instead of a per-binary
      container the next install would orphan. Absence is not equivalent: the
      switch has to be explicitly false.
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<!-- RootHide installs payloads in app containers; these are required by
	     https://github.com/roothide/Developer/blob/main/README.md -->
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
</dict>
</plist>
